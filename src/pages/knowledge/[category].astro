---
import Layout from '../../layouts/Layout.astro';
import { interests } from '../../data/interests';

export function getStaticPaths() {
  return interests.map(category => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<Layout title={`${category.title} | Laurent Crisci`} description={`Laurent Crisci’s interests and favourites in ${category.title.toLowerCase()}.`}>
  <nav aria-label="Breadcrumb"><a href="/knowledge/">Knowledge</a></nav>
  <h1>{category.title}</h1>
  {category.items.length > 0 ? (
    <ul>
      {category.items.map(item => (
        <li>
          {item.href ? <a href={item.href}>{item.title}</a> : item.title}
          {item.note && <span class="note"> — {item.note}</span>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="note">Selections coming soon.</p>
  )}
</Layout>

<style>
  .note {
    color: #5f6368;
  }
</style>
