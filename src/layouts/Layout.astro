---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Interests and notes from Laurent Crisci.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
        <a href="/knowledge/" aria-current={Astro.url.pathname === '/knowledge/' ? 'page' : Astro.url.pathname.startsWith('/knowledge/') ? 'location' : undefined}>Knowledge</a>
        <a href="/links/" aria-current={Astro.url.pathname === '/links/' ? 'page' : undefined}>Links</a>
        <a href="/contact/" aria-current={Astro.url.pathname === '/contact/' ? 'page' : undefined}>Contact</a>
      </nav>
    </header>
    <main class:list={{ 'home-page': Astro.url.pathname === '/' }}>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    font-family: system-ui, sans-serif;
    color: #202124;
    background: #fff;
    line-height: 1.6;
    font-size: 18px;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
  }

  header {
    border-bottom: 1px solid #e5e7eb;
  }

  header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: 1rem 2rem;
    box-sizing: border-box;
  }

  header a[aria-current] {
    font-weight: 600;
  }

  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .home-page {
    display: grid;
    place-items: center;
    max-width: 64rem;
  }

  @media (max-width: 40rem) {
    header nav, main {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  h1, h2 {
    line-height: 1.2;
  }

  h1 {
    font-size: 2rem;
  }

  h2 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }

  a {
    color: #174ea6;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  li + li {
    margin-top: 0.5rem;
  }
</style>
